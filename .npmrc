# better-sqlite3 ships prebuilt native binaries for every platform
# (node_modules/better-sqlite3/prebuilds/) and needs no compiler. Without
# this, npm falls back to its default "run node-gyp rebuild" behavior for
# any package with a binding.gyp and no explicit install script — which
# then fails on machines without Visual Studio Build Tools + Python
# installed (see CHANGELOG.md). Nothing else in this project's dependency
# tree needs an install/postinstall script, so this is safe project-wide.
ignore-scripts=true
