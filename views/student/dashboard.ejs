<div class="student-page">
  <h1><%= t.welcome %>, <%= student.full_name %> 👋</h1>
  <h2><%= t.yourModules %></h2>

  <div class="module-grid">
    <% if (!modules.length) { %>
      <p class="empty">Er zijn nog geen modules aan jou toegewezen. Vraag je docent om hulp via de Help-knop.</p>
    <% } %>
    <% modules.forEach(m => { %>
      <a class="module-card <%= m.completed ? 'completed' : '' %>" href="/student/module/<%= m.key %>?lang=<%= lang %>">
        <div class="module-icon"><%= m.icon %></div>
        <h3><%= m.title[lang] || m.title.nl %></h3>
        <p><%= m.description[lang] || m.description.nl %></p>
        <div class="progress-bar"><div class="progress-fill" style="width: <%= m.percent %>%"></div></div>
        <small><%= m.percent %>% <%= t.progress.toLowerCase() %><% if (m.completed) { %> · ✅<% } %></small>
      </a>
    <% }) %>
  </div>

  <section class="panel">
    <h2><%= t.glossary %></h2>
    <button type="button" id="open-glossary-dash" class="btn"><%= t.glossary %></button>
  </section>
</div>

<div id="glossary-modal" class="modal hidden">
  <div class="modal-box modal-wide">
    <h3><%= t.glossary %></h3>
    <div class="glossary-list">
      <% glossary.forEach(g => { %>
        <div class="glossary-item"><strong><%= g.term %></strong><p><%= g.definition %></p></div>
      <% }) %>
    </div>
    <div class="modal-actions">
      <button id="glossary-close-dash" class="btn btn-ghost"><%= t.cancel %></button>
    </div>
  </div>
</div>

<script>
  document.getElementById('open-glossary-dash')?.addEventListener('click', () => {
    document.getElementById('glossary-modal').classList.remove('hidden');
  });
  document.getElementById('glossary-close-dash')?.addEventListener('click', () => {
    document.getElementById('glossary-modal').classList.add('hidden');
  });
</script>
