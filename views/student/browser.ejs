<div class="practice-launch">
  <a href="<%= back %>" class="btn btn-ghost"><%- icon('arrow-left', { size: 18 }) %> <%= t.backToLesson %></a>

  <div class="practice-card">
    <div class="practice-icon"><%- icon('globe', { size: 40 }) %></div>
    <div class="browser-address"><%= url %></div>
    <p><%= t.practiceIntro %></p>

    <a href="<%= url %>" target="_blank" rel="noopener" id="practice-open-btn" class="btn btn-primary btn-large">
      <%- icon('arrow-square-out', { size: 20 }) %> <%= t.practiceOpenBtn %>
    </a>
  </div>

  <div class="practice-return">
    <h3><%- icon(device === 'desktop' ? 'desktop' : 'device-mobile', { size: 20 }) %> <%= t.practiceReturnTitle %></h3>
    <ol>
      <% if (device === 'ios') { %>
        <li><%= t.practiceReturnStep1Ios %></li>
        <li><%= t.practiceReturnStep2Ios %></li>
        <li><%= t.practiceReturnStep3Ios %></li>
      <% } else if (device === 'android') { %>
        <li><%= t.practiceReturnStep1Android %></li>
        <li><%= t.practiceReturnStep2Android %></li>
      <% } else { %>
        <li><%= t.practiceReturnStep1 %></li>
        <li><%= t.practiceReturnStep2 %></li>
        <li><%= t.practiceReturnStep3 %></li>
      <% } %>
    </ol>
    <a href="<%= back %>" class="btn btn-primary"><%- icon('arrow-left', { size: 18 }) %> <%= t.backToLesson %></a>
  </div>
</div>
