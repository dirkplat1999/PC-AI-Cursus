<div class="auth-page">
  <div class="auth-card">
    <h1><%- icon('desktop', { size: 28 }) %> <%= t.appName %></h1>

    <form method="GET" class="lang-switch-inline">
      <select name="lang" onchange="this.form.submit()">
        <option value="nl" <%= lang === 'nl' ? 'selected' : '' %>>Nederlands</option>
        <option value="en" <%= lang === 'en' ? 'selected' : '' %>>English</option>
        <option value="de" <%= lang === 'de' ? 'selected' : '' %>>Deutsch</option>
      </select>
    </form>

    <div class="role-tabs">
      <button type="button" class="role-tab active" data-role="student"><%= t.students %></button>
      <button type="button" class="role-tab" data-role="admin"><%= t.adminDashboard %></button>
    </div>

    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <% if (notice) { %><p class="notice"><%= notice %></p><% } %>

    <form method="POST" action="/login" id="login-form">
      <input type="hidden" name="lang" value="<%= lang %>">
      <input type="hidden" name="role" id="role-input" value="student">

      <div id="username-field">
        <label for="username"><%= t.username %></label>
        <input type="text" id="username" name="username" autofocus>
      </div>

      <label for="password"><%= t.password %></label>
      <input type="password" id="password" name="password" required>

      <button type="submit" class="btn btn-primary btn-block"><%= t.loginButton %></button>
    </form>

    <button type="button" id="btn-open-request-access" class="btn btn-ghost btn-block" style="margin-top: 10px;"><%= t.requestAccess %></button>
  </div>
</div>

<div id="request-access-modal" class="modal hidden">
  <div class="modal-box">
    <h3><%= t.requestAccessTitle %></h3>
    <p class="hint"><%= t.requestAccessIntro %></p>
    <form method="POST" action="/access-request" class="student-form">
      <input type="hidden" name="lang" value="<%= lang %>">
      <label for="ra-full-name"><%= t.fullName %></label>
      <input type="text" id="ra-full-name" name="full_name" required>

      <label for="ra-email"><%= t.email %></label>
      <input type="email" id="ra-email" name="email" required>

      <label for="ra-message"><%= t.requestAccessMessage %></label>
      <textarea id="ra-message" name="message" rows="3"></textarea>

      <div class="modal-actions">
        <button type="button" id="btn-cancel-request-access" class="btn btn-ghost"><%= t.cancel %></button>
        <button type="submit" class="btn btn-primary"><%= t.requestAccessSubmit %></button>
      </div>
    </form>
  </div>
</div>

<script>
  const tabs = document.querySelectorAll('.role-tab');
  const roleInput = document.getElementById('role-input');
  const usernameField = document.getElementById('username-field');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((tb) => tb.classList.remove('active'));
      tab.classList.add('active');
      roleInput.value = tab.dataset.role;
      usernameField.style.display = tab.dataset.role === 'admin' ? 'none' : 'block';
    });
  });

  const requestModal = document.getElementById('request-access-modal');
  document.getElementById('btn-open-request-access')?.addEventListener('click', () => {
    requestModal.classList.remove('hidden');
  });
  document.getElementById('btn-cancel-request-access')?.addEventListener('click', () => {
    requestModal.classList.add('hidden');
  });
</script>
