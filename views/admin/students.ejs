<div class="admin-page">
  <div class="admin-header">
    <h1><%= t.students %></h1>
    <nav class="admin-nav">
      <a href="/admin"><%= t.adminDashboard %></a>
      <a href="/admin/students" class="active"><%= t.students %></a>
      <a href="/admin/backup">Back-up &amp; herstel</a>
      <a href="/admin/changelog"><%= t.changelog %></a>
    </nav>
  </div>

  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <section class="panel">
    <h2><%= t.addStudent %></h2>
    <form method="POST" action="/admin/students" class="student-form">
      <div class="form-row">
        <div>
          <label><%= t.fullName %></label>
          <input type="text" name="full_name" required>
        </div>
        <div>
          <label><%= t.username %></label>
          <input type="text" name="username" required>
        </div>
        <div>
          <label><%= t.password %></label>
          <input type="password" name="password" minlength="6" required>
        </div>
        <div>
          <label><%= t.language %></label>
          <select name="language">
            <% langs.forEach(l => { %><option value="<%= l %>"><%= l.toUpperCase() %></option><% }) %>
          </select>
        </div>
        <div>
          <label><%= t.ageGroup %></label>
          <select name="age_group" id="age-group-new">
            <% ageGroups.forEach(a => { %><option value="<%= a %>"><%= a === 'young' ? t.ageGroupYoung : t.ageGroupSenior %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <label><%= t.assignModules %></label>
        <button type="button" class="btn btn-small" data-recommend-btn data-age-select="age-group-new" data-checkbox-scope="modules-new"><%- icon('check-circle', { size: 16 }) %> <%= t.recommendModules %></button>
      </div>
      <div class="module-checkboxes" id="modules-new">
        <% modules.forEach(m => { %>
          <label class="checkbox-pill">
            <input type="checkbox" name="modules" value="<%= m.key %>">
            <%- icon(m.icon, { size: 18 }) %> <%= m.title[lang] || m.title.nl %>
          </label>
        <% }) %>
      </div>
      <button type="submit" class="btn btn-primary"><%= t.addStudent %></button>
    </form>
  </section>

  <script>window.RECOMMENDED_MODULES = <%- JSON.stringify(recommendedModules) %>;</script>

  <section class="panel">
    <h2><%= t.students %></h2>
    <% students.forEach(s => { %>
      <details class="student-edit">
        <summary><%= s.full_name %> (<%= s.username %>) — <%= s.assignedModules.length %> module(s)</summary>
        <form method="POST" action="/admin/students/<%= s.id %>" class="student-form">
          <div class="form-row">
            <div>
              <label><%= t.fullName %></label>
              <input type="text" name="full_name" value="<%= s.full_name %>" required>
            </div>
            <div>
              <label><%= t.language %></label>
              <select name="language">
                <% langs.forEach(l => { %><option value="<%= l %>" <%= s.language === l ? 'selected' : '' %>><%= l.toUpperCase() %></option><% }) %>
              </select>
            </div>
            <div>
              <label><%= t.ageGroup %></label>
              <select name="age_group" id="age-group-<%= s.id %>">
                <% ageGroups.forEach(a => { %><option value="<%= a %>" <%= s.age_group === a ? 'selected' : '' %>><%= a === 'young' ? t.ageGroupYoung : t.ageGroupSenior %></option><% }) %>
              </select>
            </div>
            <div>
              <label>Nieuw wachtwoord (optioneel)</label>
              <input type="password" name="new_password" minlength="6" placeholder="•••••••">
            </div>
          </div>
          <div class="form-actions">
            <label><%= t.assignModules %></label>
            <button type="button" class="btn btn-small" data-recommend-btn data-age-select="age-group-<%= s.id %>" data-checkbox-scope="modules-<%= s.id %>"><%- icon('check-circle', { size: 16 }) %> <%= t.recommendModules %></button>
          </div>
          <div class="module-checkboxes" id="modules-<%= s.id %>">
            <% modules.forEach(m => { %>
              <label class="checkbox-pill">
                <input type="checkbox" name="modules" value="<%= m.key %>" <%= s.assignedModules.includes(m.key) ? 'checked' : '' %>>
                <%- icon(m.icon, { size: 18 }) %> <%= m.title[lang] || m.title.nl %>
              </label>
            <% }) %>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary"><%= t.save %></button>
          </div>
        </form>
        <form method="POST" action="/admin/students/<%= s.id %>/delete" onsubmit="return confirm('<%= t.delete %> <%= s.full_name %>?');">
          <button type="submit" class="btn btn-danger btn-small"><%= t.delete %></button>
        </form>
      </details>
    <% }) %>
  </section>
</div>
